{% block ruvelo_security_alerts_index %}
<sw-page class="ruvelo-security-alerts">
    {% block ruvelo_security_alerts_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('ruvelo-security-alerts.general.title') }}</h2>
    </template>
    {% endblock %}

    {% block ruvelo_security_alerts_smart_bar_actions %}
    <template #smart-bar-actions>
        <sw-button
            v-if="canCheck"
            variant="primary"
            :is-loading="isChecking"
            :disabled="isChecking"
            @click="checkNow"
        >
            {{ $tc('ruvelo-security-alerts.actions.checkNow') }}
        </sw-button>
    </template>
    {% endblock %}

    {% block ruvelo_security_alerts_content %}
    <template #content>
        <sw-card-view>
            <sw-card
                position-identifier="ruvelo-security-alerts-findings"
                :title="$tc('ruvelo-security-alerts.cards.findings')"
                :is-loading="isLoading"
            >
                <p v-if="neverChecked" class="ruvelo-security-alerts__note">
                    {{ $tc('ruvelo-security-alerts.messages.neverChecked') }}
                </p>
                <p v-else-if="incomplete" class="ruvelo-security-alerts__note ruvelo-security-alerts__note--warn">
                    {{ $tc('ruvelo-security-alerts.messages.incomplete') }}
                    <span v-for="problem in lastCheck.problems" :key="problem">{{ problem }} </span>
                </p>
                <p v-else-if="findings.length === 0" class="ruvelo-security-alerts__note">
                    {{ $tc('ruvelo-security-alerts.messages.clean', lastCheck.packages, { count: lastCheck.packages }) }}
                </p>
                <p v-else-if="exploitedCount > 0" class="ruvelo-security-alerts__note ruvelo-security-alerts__note--danger">
                    {{ $tc('ruvelo-security-alerts.messages.exploited', exploitedCount, { count: exploitedCount }) }}
                </p>

                <table v-if="findings.length > 0" class="ruvelo-security-alerts__table">
                    <thead>
                        <tr>
                            <th v-for="column in columns" :key="column.property">{{ $tc(column.label) }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in findings" :key="item.key">
                            <td>
                                <strong>{{ item.package }}</strong>
                                <sw-label
                                    v-if="item.exploited"
                                    variant="danger"
                                    appearance="pill"
                                    size="small"
                                >
                                    {{ $tc('ruvelo-security-alerts.labels.exploited') }}
                                </sw-label>
                            </td>
                            <td>{{ item.installed }}</td>
                            <td>
                                <a v-if="item.link" :href="item.link" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
                                <span v-else>{{ item.title }}</span>
                                <div v-if="item.cve" class="ruvelo-security-alerts__cve">{{ item.cve }}</div>
                            </td>
                            <td>{{ item.severity_label }}</td>
                            <td>{{ item.fixed_in || '–' }}</td>
                        </tr>
                    </tbody>
                </table>
                <p v-if="sourceLabel" class="ruvelo-security-alerts__note ruvelo-security-alerts__source">
                    {{ $tc('ruvelo-security-alerts.labels.source') }}: {{ sourceLabel }}
                </p>
            </sw-card>

            <sw-card
                v-if="notChecked.length > 0"
                position-identifier="ruvelo-security-alerts-not-checked"
                :title="$tc('ruvelo-security-alerts.cards.notChecked')"
                :is-loading="isLoading"
            >
                <p class="ruvelo-security-alerts__note">{{ $tc('ruvelo-security-alerts.messages.notChecked') }}</p>
                <ul class="ruvelo-security-alerts__list">
                    <li v-for="plugin in notChecked" :key="plugin.name">
                        <strong>{{ plugin.name }}</strong> {{ plugin.version }}
                        <span class="ruvelo-security-alerts__muted">{{ $tc('ruvelo-security-alerts.labels.notChecked') }}</span>
                    </li>
                </ul>
            </sw-card>
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
